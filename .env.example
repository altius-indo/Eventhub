# PostgreSQL connection string
DATABASE_URL=postgresql://eventhub:eventhub@localhost:5432/eventhub
# Used only by `npm test` (integration tests create and wipe tables here)
TEST_DATABASE_URL=postgresql://eventhub:eventhub@localhost:5432/eventhub_test

# Public base URL of the app (used in emails and links)
APP_URL=http://localhost:3000

# Secret used to hash OTP codes and session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Comma-separated emails/phones that are App Admins (applied when they log in)
APP_ADMIN_IDENTIFIERS=admin@example.com

# Message delivery. "dev" writes messages to the database outbox, viewable at
# /dev/outbox (disabled in production). "smtp" sends real email.
EMAIL_PROVIDER=dev
SMTP_URL=smtp://user:pass@smtp.example.com:587
EMAIL_FROM="EventHub <no-reply@example.com>"
# Phone OTP (SMS / WhatsApp) stays on "dev" until DLT and WhatsApp templates
# are approved; "disabled" hides phone login.
PHONE_PROVIDER=dev
